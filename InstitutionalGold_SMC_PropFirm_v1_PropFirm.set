BiasTimeframe=240
SignalTimeframe=15
EMA_Period_Bias=200
RSI_Period=14
ATR_Period=14
SwingLookbackMin=20
SwingLookbackMax=50
OB_MaxAge_Bars=48
OB_BodyRatio=0.42
ImpulseBodyRatio=0.55
ImpulseMinATRMult=0.85
FVG_LookbackBars=80
MinConfluenceRequired=4
MinRR=2.0
ATRMultiplierSL=1.5
SL_BufferPoints=30.0

UseBreakeven=true
BreakevenAtR=1.0
UseTrailing=true
TrailingStartR=1.0
Trail_ATR_Mult=0.75
